#!/bin/sh
# hub — PATH shim: runs the repo's hub_cli.py with ${HUB_PYTHON:-python3}.
# Resolve the repo dir from this script's location so the shim is relocatable.
SELF=$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0")
HUB_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd -P)
PY="${HUB_PYTHON:-python3}"
[ -x "$PY" ] || PY=python3
exec "$PY" "$HUB_DIR/hub_cli.py" "$@"
